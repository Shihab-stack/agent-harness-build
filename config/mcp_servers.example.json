{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-time==2026.10.10",
        "mcp-server-time"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-server-fetch==2026.10.10",
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@1.0.0"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github@2025.4.8"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.2"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@1.0.0"
      ]
    },
    "sandbox": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "agent_herness_build.sandbox_mcp"
      ]
    }
  }
}
